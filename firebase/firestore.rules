rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Role checked against Firestore document (not custom claims).
    // For performance-critical rules, use hasCustomClaim() instead.
    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(userPath)
        && get(userPath).data.role == 'admin';
    }

    // Role checked against Firebase Auth custom claims — no Firestore read needed.
    // Set custom claims via Admin SDK: adminAuth.setCustomUserClaims(uid, { admin: true })
    function hasCustomClaim(claim) {
      return isAuthenticated() && request.auth.token[claim] == true;
    }

    // Soft-delete guard — filters out logically deleted documents.
    // Include in read rules: allow read: if isOwner(userId) && notDeleted();
    function notDeleted() {
      return resource == null || !('deletedAt' in resource.data) || resource.data.deletedAt == null;
    }

    // Comment reads follow the parent note: it must exist, be active, and the
    // caller must be its owner or an active recipient. Firestore caches repeated
    // get() calls to the same document within a single request.
    function canReadNote(noteId) {
      let notePath = /databases/$(database)/documents/notes/$(noteId);
      return isAuthenticated()
        && exists(notePath)
        && (!('deletedAt' in get(notePath).data) || get(notePath).data.deletedAt == null)
        && (isOwner(get(notePath).data.uid)
            || ('sharedWithUids' in get(notePath).data
                && request.auth.uid in get(notePath).data.sharedWithUids));
    }

    // ── Collections ────────────────────────────────────────────────────────

    // users/{userId}
    // Each user can only read and update their own profile.
    // Admins can read any profile.
    // Creation is triggered by AuthProvider on first sign-in (syncUserProfile).
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin()) && notDeleted();

      allow create: if isAuthenticated() && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.role == 'user';  // only admin SDK can set 'admin' role

      allow update: if isAuthenticated() && isOwner(userId)
        && request.resource.data.uid == resource.data.uid    // uid is immutable
        && request.resource.data.role == resource.data.role  // role is immutable by user
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt', '_schemaVersion']);

      allow delete: if false; // soft-delete only — set deletedAt field instead
    }

    // notes/{noteId}
    // Owners can read and write their own notes. Users listed in
    // `sharedWithUids` get view-only read access. The owner keeps reading
    // soft-deleted notes (the UI filters them) because Firestore cannot query
    // for documents where a field is missing.
    //
    // `sharedWithUids` and `deletedAt` are only written by Server Actions
    // (Admin SDK), which bypass these rules. Client updates are limited to the
    // note content so a recipient cannot grant themselves access.
    match /notes/{noteId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.uid)
        || ('sharedWithUids' in resource.data
            && request.auth.uid in resource.data.sharedWithUids)
      );

      allow create: if isAuthenticated() && isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasAll(['uid', 'title', 'body', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.keys().hasOnly(['uid', 'title', 'body', 'createdAt', 'updatedAt', '_schemaVersion']);

      allow update: if isAuthenticated() && isOwner(resource.data.uid)
        && notDeleted()
        && request.resource.data.uid == resource.data.uid  // uid is immutable
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'updatedAt']);

      allow delete: if false; // soft-delete only — set deletedAt instead
    }

    // noteShares/{noteId}_{recipientUid}
    // Sharing audit records are readable by the note owner and the recipient.
    // Revoked shares are not readable. Clients can never write these records —
    // only Server Actions using the Admin SDK can create or revoke a share.
    match /noteShares/{shareId} {
      allow read: if isAuthenticated()
        && resource.data.revokedAt == null
        && (isOwner(resource.data.ownerUid) || isOwner(resource.data.recipientUid));

      allow write: if false;
    }

    // noteComments/{commentId}
    // Comments are readable by the note owner and active recipients. Clients
    // can never write comments — only the addNoteComment Server Action using
    // the Admin SDK can create them.
    match /noteComments/{commentId} {
      allow read: if canReadNote(resource.data.noteId);
      allow write: if false;
    }

    // ── Default deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
